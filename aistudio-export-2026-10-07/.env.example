# Server-only Gemini provider selection. Never give these credentials to demo visitors.
# false: Developer API, requires a real server GEMINI_API_KEY (AI Studio Secrets).
# true: Vertex AI with the Cloud Run service identity / Application Default Credentials;
#       no Gemini API key is required. The cloud owner configures model IAM/billing.
GOOGLE_GENAI_USE_VERTEXAI="false"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Leave blank to select the server default for this mode:
# Developer API: gemini-3.1-flash-lite; Vertex AI: gemini-2.5-flash.
# Optional IDs must be allowed by server/runtime-config.ts and available to the project.
# Allowlisting a name does not prove availability or billing tier.
GEMINI_MODEL=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# S3 persistent cases are opt-in. A Gemini credential is not a Firebase web key.
# disabled = plan/review only; emulator = explicit local demo; firestore = owner-configured cloud.
OPSCREW_FIREBASE_MODE="disabled"
FIREBASE_PROJECT_ID=""
FIREBASE_WEB_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_WEB_APP_ID=""
# Emulator-only hosts (no protocol). Set both ONLY with a demo- project and emulator mode.
# FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
# FIRESTORE_EMULATOR_HOST="127.0.0.1:8080"
# Real cloud mode uses Application Default Credentials; do not commit service-account files.
